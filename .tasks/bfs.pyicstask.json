    "solution_code": [
        "import operator\n\n\ndef neighbors(graph: list[tuple[str, str, int]], node: str) -> list[str]:\n    \"\"\"Return the successors of a node.\"\"\"\n    return sorted(map(operator.itemgetter(1), filter(lambda x: x[0] == node, graph)))\n\n\ndef breadth_first_search(\n    graph: list[tuple[str, str, int]], start: str, goal: str\n) -> tuple[str, ...] | None:\n    \"\"\"Return a path from start to goal using depth-first search.\"\"\"\n    queue = []\n    queue.append((start,))\n    print(queue, \"\\n\")\n    while queue:\n        path = queue.pop(0)\n        node = path[-1]\n        print(\"Terminal node\", node)\n        if node == goal:\n            return path\n        print(f\"Neighbors of {node}:\", neighbors(graph, node))\n        for neighbor in neighbors(graph, node):\n            if neighbor in path:\n                continue\n            queue.append(path + (neighbor,))\n        print(\"Current queue:\", queue, \"\\n\")\n    return None\n"
    ],
