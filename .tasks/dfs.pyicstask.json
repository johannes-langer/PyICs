    "solution_code": [
        "import operator\n\n\ndef neighbors(graph: list[tuple[str, str, int]], node: str) -> list[str]:\n    \"\"\"Return the successors of a node.\"\"\"\n    return sorted(map(operator.itemgetter(1), filter(lambda x: x[0] == node, graph)))\n\n\ndef depth_first_search(\n    graph: list[tuple[str, str, int]], start: str, goal: str\n) -> tuple[str, ...] | None:\n    \"\"\"Return a path from start to goal using depth-first search.\"\"\"\n    stack = []\n    stack.append((start,))\n    print(stack)\n    while stack:\n        path = stack.pop()\n        node = path[-1]\n        print(\"Terminal node\", node)\n        if node == goal:\n            return path\n        print(f\"Neighbors of {node}:\", neighbors(graph, node))\n        for neighbor in reversed(neighbors(graph, node)):\n            if neighbor in path:\n                continue\n            stack.append(path + (neighbor,))\n        print(\"Current stack:\", stack)\n    return None\n"
    ],
